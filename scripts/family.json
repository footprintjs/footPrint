{
  "$comment": "The footprintjs family, one list. scripts/audit-consumers.mjs audits every entry with `checks` against each footprintjs release candidate (docs/guides/consumer-audit.md). scripts/audit-family-versions.mjs reads every entry: `published` ones are the family packages whose versions it compares; the rest are apps it checks for drift. `dir` is the checkout's directory name under the org root, and in the audit's workspace.",
  "family": [
    {
      "package": "foottrace",
      "repo": "footprintjs/foottrace",
      "dir": "foottrace",
      "published": true
    },
    {
      "package": "footprintjs",
      "repo": "footprintjs/footPrint",
      "dir": "footPrint",
      "published": true
    },
    {
      "package": "hcifootprint",
      "repo": "footprintjs/hcifootprint",
      "branch": "main",
      "dir": "hcifootprint",
      "published": true,
      "checks": ["npm run typecheck", "npm test"]
    },
    {
      "package": "agentfootprint",
      "repo": "footprintjs/agentfootprint",
      "branch": "main",
      "dir": "agentfootprint",
      "published": true,
      "checks": ["npx tsc --noEmit", "npm run test:types", "npm run build", "npm test"]
    },
    {
      "package": "agentfootprint-lens",
      "repo": "footprintjs/agentfootprint-lens",
      "branch": "main",
      "dir": "agentfootprint-lens",
      "published": true,
      "registry": ["agentfootprint"],
      "checks": ["npm run build", "npm test"]
    },
    {
      "package": "footprint-storyreel",
      "repo": "footprintjs/storyreel",
      "branch": "main",
      "dir": "storyreel",
      "published": true,
      "apt": ["ffmpeg"],
      "checks": ["npm test"]
    },
    {
      "package": "vizfootprint",
      "repo": "footprintjs/vizfootprint",
      "branch": "main",
      "dir": "vizfootprint",
      "published": false,
      "registry": ["agentfootprint"],
      "note": "ui/ links ../../storydeck, so storydeck is a sibling checkout with its own dependencies. The browser tests launch Playwright's headless shell, so setup fetches it. The demo-agent tests read the built ui stylesheet, so build:ui runs first.",
      "siblings": [{ "repo": "footprintjs/storydeck", "branch": "main", "dir": "storydeck", "setup": "npm ci" }],
      "setup": "npx playwright-core install chromium-headless-shell",
      "checks": ["npm run build:ui", "npm run typecheck", "npm test"]
    },
    {
      "package": "footprint-playground",
      "repo": "footprintjs/footprint-playground",
      "branch": "main",
      "dir": "footprint-playground",
      "published": false,
      "note": "Authored local footprintjs and explainable-ui requests are replaced by the candidate archive and published UI before the first strict install, matching the app's CI preparation. src/samples/examples links ../../../footPrint/examples, which the workspace provides.",
      "installStrategy": "packaged",
      "registry": ["footprint-explainable-ui"],
      "checks": ["npm run build", "npm test"]
    },
    {
      "package": "agent-playground",
      "repo": "footprintjs/agent-playground",
      "branch": "main",
      "dir": "agent-playground",
      "published": false,
      "note": "Uses published AgentFootprint, Lens and explainable-ui with the candidate engine. The AgentFootprint sibling supplies examples only, without an independent dependency install; example source resolves through the app's complete installed tree as in its own CI. The unused agent-samples dependency was removed by the consumer migration.",
      "installStrategy": "packaged",
      "siblings": [
        {
          "repo": "footprintjs/agentfootprint",
          "branch": "main",
          "dir": "agentfootprint",
          "sourceOnly": true
        }
      ],
      "registry": ["agentfootprint", "agentfootprint-lens", "footprint-explainable-ui"],
      "checks": ["npm run build", "npm test"]
    },
    {
      "package": "footprint-explainable-ui",
      "repo": "footprintjs/explainable-ui",
      "dir": "explainable-ui",
      "published": true
    },
    {
      "package": "agentthinkingui",
      "repo": "footprintjs/agentThinkingUI",
      "dir": "agentThinkingUI",
      "published": true
    },
    {
      "package": "neo-agentfootprint",
      "dir": "neo-agentfootprint",
      "published": false
    }
  ]
}
