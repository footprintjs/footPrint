---
import { LinkCard, CardGrid } from '@astrojs/starlight/components';
interface Link { href: string; label: string }
interface Props { prev?: Link; next?: Link }
const { prev, next } = Astro.props;
---
{(prev || next) && <div class="sl-blog-pagination" data-pagefind-ignore><CardGrid>
  {prev && <LinkCard href={prev.href} rel="prev" title={prev.label} />}
  {next && <LinkCard href={next.href} rel="next" title={next.label} />}
</CardGrid></div>}
