{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/recorders.ts",
    "src/trace.ts",
    "src/detach.ts",
    "src/sinks.ts",
    "src/zod.ts",
    "src/advanced.ts"
  ],
  "entryPointStrategy": "resolve",
  "sortEntryPoints": false,
  "out": "api-docs",
  "json": "api-docs.json",
  "name": "footprintjs",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "includeVersion": true,
  "categorizeByGroup": false,
  "searchInComments": true,
  "useFirstParagraphOfCommentAsSummary": true,
  "includeHierarchySummary": false,
  "hideGenerator": true,
  "suppressCommentWarningsInDeclarationFiles": true,
  "categoryOrder": [
    "Quick Start",
    "Decision Branching",
    "Run",
    "Observe: Data",
    "Observe: Flow",
    "Self-Describing",
    "Snapshot & Composition",
    "Contract & Validation",
    "Error Utilities",
    "Dev Tools",
    "*"
  ],
  "navigation": {
    "includeFolders": false
  },
  "navigationLinks": {
    "Docs": "https://footprintjs.github.io/footPrint/",
    "Import map": "https://footprintjs.github.io/footPrint/api/import-map/",
    "GitHub": "https://github.com/footprintjs/footPrint",
    "npm": "https://www.npmjs.com/package/footprintjs",
    "Playground": "https://footprintjs.github.io/footprint-playground/"
  }
}
