# Dependencies
/node_modules

# Build outputs
/build
/dist
/coverage

# Logs
*.log
build.log
npm-debug.log*

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*

# Package manager
*.tgz

# Screenshots (Playwright testing artifacts)
*.png

# Generated API docs (TypeDoc)
/api-docs

# Bench machine results: latest.json is regenerated by every `npm run bench`;
# only the reviewed reference (baseline.json) is committed.
/bench/results/latest.json

# Starlight docs site build outputs (built by CI)
/docs-site/dist
/docs-site/.astro

# Claude Code — local state stays ignored, but .claude/rules/ is TRACKED
# (path-scoped agent rules, e.g. backtracking.md, belong in the repo).
# Note: git can't re-include inside an excluded DIR, hence .claude/* not .claude/
.claude/*
!.claude/rules/
.playwright-mcp/
coverage

# Commit the root development lock; npm excludes it from the published library.
# docs-site/package-lock.json belongs to the separate deployed docs application.

# Scratch folder at the repo root (PDFs, notes) — never part of the package
tmp/
